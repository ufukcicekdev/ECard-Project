{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
      "builder": "NIXPACKS",
      "pythonVersion": "3.11"
    },
    "deploy": {
      "numReplicas": 1,
      "startCommand": "bash deploy.sh",
      "sleepApplication": false,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10
    }
  }